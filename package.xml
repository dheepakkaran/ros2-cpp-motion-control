<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_motion_control</name>
  <version>0.1.0</version>
  <description>C++17 ROS 2 joint trajectory controller (quintic + PD + gravity compensation) for a MuJoCo-simulated Franka Panda. Simulation only.</description>
  <maintainer email="67942227+dheepakkaran@users.noreply.github.com">Dheepak Karan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
